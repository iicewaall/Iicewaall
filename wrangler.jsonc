// Cloudflare Workers deploy (static site). Build first:
//   cd angular && npm ci && npx ng build && node scripts/product-pages.mjs
// then `npx wrangler deploy` serves angular/dist.
{
  "name": "iicewaall",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./angular/dist",
    "not_found_handling": "404-page"
  }
}
